-- Runtime script
if Controls then
  -- Load required libraries
  local rapidjson
  local json_available = pcall(function()
    rapidjson = require("rapidjson")
  end)
  
  if not json_available then
    print("ERROR: rapidjson library not available. Plugin cannot function.")
  end
  
  -- Status constants
  local STATUS_OK = 0
  local STATUS_COMPROMISED = 1
  local STATUS_FAULT = 2
  local STATUS_NOT_PRESENT = 3
  local STATUS_MISSING = 4
  local STATUS_INITIALIZING = 5
  
  -- Configuration constants
  local HTTP_TIMEOUT = 30
  local DEFAULT_SHUTDOWN_TIME = 1  -- Default shutdown delay in minutes
  
  -- Initialize controls with default values
  Controls.host.String = Properties["Host"].Value
  Controls.port.String = tostring(Properties["Port"].Value)
  Controls.status.Value = STATUS_INITIALIZING
  Controls.statusText.String = "Initializing"
  
  -- Set initial command list (this would be better as a dropdown in a real implementation)
  Controls.command.String = "shutdown"
  
  -- Helper function to send HTTP POST request
  function SendCommand()
    local host = Controls.host.String
    local port = Controls.port.String
    local password = Controls.password.String
    local command = Controls.command.String
    
    -- Validate inputs
    if host == "" then
      Controls.status.Value = STATUS_FAULT
      Controls.statusText.String = "Error: Host required"
      return
    end
    
    if port == "" then
      Controls.status.Value = STATUS_FAULT
      Controls.statusText.String = "Error: Port required"
      return
    end
    
    if command == "" then
      Controls.status.Value = STATUS_FAULT
      Controls.statusText.String = "Error: Command required"
      return
    end
    
    -- Build payload based on command
    local payload = {
      command = command,
      password = password
    }
    
    -- Add parameters based on command type
    -- System Commands
    if command == "shutdown" then
      local time = Controls.time.String
      if time ~= "" then
        payload.time = tonumber(time) or DEFAULT_SHUTDOWN_TIME
      end
    
    -- Script Commands
    elseif command == "runScript" then
      payload.executable = Controls.executable.String
      payload.args = Controls.args.String
      payload.stdin = Controls.stdin.String
    
    -- Input Commands
    elseif command == "sendInput" then
      payload.type = Controls.inputType.String
      payload.key = Controls.key.String
    
    -- UI Commands
    elseif command == "sendAlert" then
      payload.message = Controls.message.String
    
    -- File Commands
    elseif command == "moveFile" then
      payload.sourcePath = Controls.sourcePath.String
      payload.destPath = Controls.destPath.String
      payload.copyOnly = Controls.copyOnly.Boolean
    
    elseif command == "moveDatedFileInFolder" then
      payload.sourceFolderPath = Controls.sourceFolderPath.String
      payload.destFolderPath = Controls.destFolderPath.String
      payload.newestOrOldest = Controls.newestOrOldest.String
      payload.fileExtension = Controls.fileExtension.String
      payload.fileName = Controls.fileName.String
      payload.copyOnly = Controls.copyOnly.Boolean
    
    elseif command == "moveDatedFileInFolderWithExtension" then
      payload.sourceFolderPath = Controls.sourceFolderPath.String
      payload.destFolderPath = Controls.destFolderPath.String
      payload.newestOrOldest = Controls.newestOrOldest.String
      payload.fileExtension = Controls.fileExtension.String
      payload.fileName = Controls.fileName.String
      payload.copyOnly = Controls.copyOnly.Boolean
    
    elseif command == "moveFileBasedOnSize" then
      payload.sourceFolderPath = Controls.sourceFolderPath.String
      payload.destFolderPathLarger = Controls.destFolderPathLarger.String
      payload.destFolderPathSmaller = Controls.destFolderPathSmaller.String
      -- Require explicit size threshold - no default to avoid unexpected behavior
      local threshold = Controls.sizeThreshold.String
      if threshold ~= "" then
        payload.sizeThreshold = tonumber(threshold)
      end
      payload.fileExtension = Controls.fileExtension.String
      payload.fileName = Controls.fileName.String
      payload.copyOnly = Controls.copyOnly.Boolean
    
    -- App Commands
    elseif command == "focusApp" or command == "quitApp" then
      payload.appName = Controls.appName.String
    end
    
    -- Convert payload to JSON
    local jsonPayload = rapidjson.encode(payload)
    
    -- Build URL
    local url = string.format("http://%s:%s/command", host, port)
    
    -- Update status
    Controls.status.Value = STATUS_COMPROMISED
    Controls.statusText.String = "Sending..."
    
    -- Send HTTP POST request
    HttpClient.Upload {
      Url = url,
      Method = "POST",
      Headers = {
        ["Content-Type"] = "application/json"
      },
      Data = jsonPayload,
      Timeout = HTTP_TIMEOUT,
      EventHandler = function(tbl, code, data, err, headers)
        if code == 200 then
          -- Success
          Controls.status.Value = STATUS_OK
          Controls.statusText.String = "Command sent"
          
          -- Try to parse response
          local success, result = pcall(function()
            return rapidjson.decode(data)
          end)
          
          if success and result then
            if result.message then
              Controls.result.String = result.message
            elseif result.error then
              Controls.result.String = "Error: " .. tostring(result.error)
              Controls.status.Value = STATUS_FAULT
              Controls.statusText.String = "Command error"
            else
              Controls.result.String = data
            end
          else
            Controls.result.String = data
          end
        elseif code == 0 then
          -- Connection error
          Controls.status.Value = STATUS_FAULT
          Controls.statusText.String = "Connection failed"
          Controls.result.String = "Error: " .. tostring(err)
        else
          -- HTTP error
          Controls.status.Value = STATUS_FAULT
          Controls.statusText.String = "HTTP error " .. tostring(code)
          Controls.result.String = "Error: " .. tostring(data or err)
        end
      end
    }
  end
  
  -- Event handler for send command button
  Controls.sendCommand.EventHandler = function()
    SendCommand()
  end
  
  -- Set initial status to OK after initialization
  Timer.CallAfter(function()
    Controls.status.Value = STATUS_OK
    Controls.statusText.String = "Ready"
  end, 1)
end
