-- ScriptLauncher Control Plugin for Q-SYS
-- Version: 1.0.0
-- Description: Control remote ScriptLauncher with persistent connection settings
-- Author: HLD

PluginInfo = {
  Name = "PKE~ScriptLauncherControl",
  Version = "1.0.0",
  BuildVersion = "1.0.0.0",
  Id = "scriptlauncher.control.v1",
  Author = "HLD",
  Description = "Control ScriptLauncher"
}

-- Define the color of the plugin object in the design
function GetColor(props)
  return { 102, 102, 102 }
end

-- The name that will initially display when dragged into a design
function GetPrettyName(props)
  return "ScriptLauncher Control v" .. PluginInfo.Version
end

-- Define User Properties (PERSISTENT - saved with design file)
function GetProperties()
  local props = {
    {
      Name = "IP Address",
      Type = "string",
      Value = "localhost"
    },
    {
      Name = "Port",
      Type = "integer",
      Min = 1,
      Max = 65535,
      Value = 8810
    },
    {
      Name = "Password",
      Type = "string",
      Value = ""
    },
    {
      Name = "Auto Reconnect",
      Type = "boolean",
      Value = true
    },
    {
      Name = "Command Buttons",
      Type = "integer",
      Min = 1,
      Max = 20,
      Value = 2
    },
    {
      Name = "Debug",
      Type = "boolean",
      Value = false
    }
  }
  return props
end

-- Defines the Controls used within the plugin
function GetControls(props)
  local ctrls = {
    -- Connection Controls (editable in UI)
    {
      Name = "host",
      ControlType = "Text",
      Count = 1,
      UserPin = true
    },
    {
      Name = "port",
      ControlType = "Text",
      Count = 1,
      UserPin = true
    },
    {
      Name = "password",
      ControlType = "Text",
      Count = 1,
      UserPin = true
    },
    {
      Name = "connect",
      ControlType = "Button",
      ButtonType = "Toggle",
      Count = 1,
      UserPin = true
    },
    {
      Name = "connection_status",
      ControlType = "Indicator",
      IndicatorType = "Status",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    {
      Name = "status_text",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    {
      Name = "remote_hostname",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    {
      Name = "remote_version",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    {
      Name = "remote_platform",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    {
      Name = "remote_uptime",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    -- System Commands
    {
      Name = "shutdown",
      ControlType = "Button",
      ButtonType = "Trigger",
      PinStyle = "Both",
      Count = 1,
      UserPin = true
    },
    {
      Name = "shutdown_time",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "reboot",
      ControlType = "Button",
      ButtonType = "Trigger",
      PinStyle = "Both",
      Count = 1,
      UserPin = true
    },
    {
      Name = "lock",
      ControlType = "Button",
      ButtonType = "Trigger",
      PinStyle = "Both",
      Count = 1,
      UserPin = true
    },
    {
      Name = "shutdown_cancel",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    -- Script Execution
    {
      Name = "run_script",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "script_path",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "script_args",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "script_stdin",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    -- Alert System
    {
      Name = "send_alert",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "alert_message",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    -- System Info
    {
      Name = "get_system_info",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "get_fonts",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "system_info",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    },
    -- App Control
    {
      Name = "focus_app",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "app_name",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "quit_app",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    -- Input Commands
    {
      Name = "send_input",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "input_type",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "input_key",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    -- File Commands
    {
      Name = "move_file",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    {
      Name = "file_source",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "file_dest",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "file_copy_only",
      ControlType = "Button",
      ButtonType = "Toggle",
      Count = 1,
      UserPin = true
    },
    -- Custom Command
    {
      Name = "custom_command",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "custom_json",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    },
    {
      Name = "send_custom",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    },
    -- Response
    {
      Name = "last_response",
      ControlType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    }
  }
  
  -- Add custom command buttons
  for i = 1, props["Command Buttons"].Value do
    table.insert(ctrls, {
      Name = "cmd_" .. i .. "_trigger",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true
    })
    table.insert(ctrls, {
      Name = "cmd_" .. i .. "_name",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    })
    table.insert(ctrls, {
      Name = "cmd_" .. i .. "_json",
      ControlType = "Text",
      PinStyle = "Input",
      Count = 1,
      UserPin = true
    })
  end
  
  return ctrls
end

