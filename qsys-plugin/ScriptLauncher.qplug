-- ScriptLauncher Q-SYS Plugin
-- Integrates with ScriptLauncher (https://github.com/josephdadams/ScriptLauncher)
-- Provides comprehensive control over system, script, input, UI, file, and app commands

PluginInfo = {
  Name = "ScriptLauncher",
  Version = "1.0.0",
  BuildVersion = "1.0.0",
  Id = "scriptlauncher.control.v1",
  Author = "DHPKE",
  Description = "Control ScriptLauncher system commands via REST API"
}

-- Define color for the plugin icon
function GetColor(props)
  return { 102, 102, 102 }
end

-- Define the plugin properties that appear in the Q-SYS Designer
function GetProperties()
  local props = {
    {
      Name = "Host",
      Type = "string",
      Value = "localhost"
    },
    {
      Name = "Port",
      Type = "integer",
      Min = 1,
      Max = 65535,
      Value = 8810
    }
  }
  return props
end

