      PrettyName = "Name " .. i,
      Style = "Text",
      Position = {130, button_y},
      Size = {100, 25}
    }
    
    graphics[#graphics + 1] = {
      Type = "Text",
      Text = "JSON:",
      Font = "Roboto",
      FontSize = 10,
      Position = {235, button_y + 3},
      Size = {45, 16},
      HTextAlign = "Right"
    }
    
    layout["cmd_" .. i .. "_json"] = {
      PrettyName = "JSON " .. i,
      Style = "Text",
      Position = {285, button_y},
      Size = {170, 25}
    }
  end
  
  -- Response Section
  y_pos = 820 + (props["Command Buttons"].Value * 30)
  graphics[#graphics + 1] = {
    Type = "GroupBox",
    Fill = {102, 102, 102},
    StrokeWidth = 1,
    Position = {5, y_pos},
    Size = {460, 60}
  }
  graphics[#graphics + 1] = {
    Type = "Text",
    Text = "Last Response",
    Font = "Roboto",
    FontSize = 12,
    FontStyle = "Bold",
    Position = {10, y_pos + 5},
    Size = {150, 16}
  }
  
  layout["last_response"] = {
    PrettyName = "Response",
    Style = "Text",
    Position = {10, y_pos + 25},
    Size = {445, 25}
  }
  
  return layout, graphics
end

-- Start of the Runtime
if Controls then
  -- Simple JSON string builder (no library needed)
  local function BuildJsonString(tbl)
    local pairs_list = {}
    for k, v in pairs(tbl) do
      local value_str
      if type(v) == "string" then
        -- Escape JSON control characters
        local escaped = v:gsub('\\', '\\\\')  -- Backslash first
                        :gsub('"', '\\"')      -- Quote
                        :gsub('\n', '\\n')     -- Newline
                        :gsub('\r', '\\r')     -- Carriage return
                        :gsub('\t', '\\t')     -- Tab
                        :gsub('\b', '\\b')     -- Backspace
                        :gsub('\f', '\\f')     -- Form feed
        value_str = '"' .. escaped .. '"'
      elseif type(v) == "number" then
        value_str = tostring(v)
      elseif type(v) == "boolean" then
        value_str = tostring(v)
      else
        value_str = '""'
      end
      table.insert(pairs_list, '"' .. k .. '":' .. value_str)
    end
    return "{" .. table.concat(pairs_list, ",") .. "}"
  end
  
  -- Parse and format response for display
  local function ParseResponse(response_data)
    if not response_data or response_data == "" then
      return "No response"
    end
    
    -- Try to parse as JSON
    local success, parsed = pcall(function()
      -- Simple JSON parsing for common response patterns
      -- Check if it's already a simple string message
      if not response_data:match("^{") then
        return response_data
      end
      
      -- Extract common fields from JSON responses
      local message = response_data:match('"message"%s*:%s*"([^"]*)"')
      local status = response_data:match('"status"%s*:%s*"([^"]*)"')
      local success_flag = response_data:match('"success"%s*:%s*([^,}]*)')
      local error_msg = response_data:match('"error"%s*:%s*"([^"]*)"')
      
      -- Build formatted output
      local output = ""
      
      if message then
        output = message
      elseif status then
        output = "Status: " .. status
      elseif success_flag then
        output = "Success: " .. success_flag
      else
        -- If we can't parse it nicely, return truncated raw data
        if #response_data > 100 then
          output = response_data:sub(1, 97) .. "..."
        else
          output = response_data
        end
      end
      
      -- Append error if present
      if error_msg and error_msg ~= "" then
        output = output .. " | Error: " .. error_msg
      end
      
      return output
    end)
    
    if success and parsed then
      return parsed
    else
      -- If parsing fails, return truncated raw data
      if #response_data > 100 then
        return response_data:sub(1, 97) .. "..."
      else
        return response_data
      end
    end
  end
  
  -- Variables - READ FROM CONTROLS (EDITABLE IN UI)
  local auto_reconnect = Properties["Auto Reconnect"].Value
  local debug = Properties["Debug"].Value
  
  -- Helper functions to get current connection settings from Controls
  local function GetHost()
    return Controls.host.String or "localhost"
  end
  
  local function GetPort()
    return tonumber(Controls.port.String) or 8810
  end
  
  local function GetPassword()
    return Controls.password.String or ""
  end
  
  local is_connected = false
  local reconnect_timer = nil
  local keepalive_timer = nil
  
  -- Helper Functions
  local function Debug(msg)
    if debug then
      print("[ScriptLauncher] " .. msg)
    end
  end
  
  local function UpdateStatus(state, message)
    Controls.connection_status.Value = state
    Controls.status_text.String = message
    Debug("Status: " .. message)
  end
  
  function Connect()
    local host = GetHost()
    local port = GetPort()
    
    if host == "" then
      UpdateStatus(2, "Host/IP address required")
      Controls.connect.Boolean = false
      return
    end
    
    if reconnect_timer then
      reconnect_timer:Stop()
      reconnect_timer = nil
    end
    
    UpdateStatus(5, "Connecting to " .. host .. ":" .. port)
    Debug("Initiating connection...")
    
    -- Test connection with /commands endpoint
    local url = HttpClient.CreateUrl({
      Host = host,
      Port = port,
      Path = "commands"
    })
    
    HttpClient.Download {
      Url = url,
      Timeout = 5,
      EventHandler = function(tbl, code, data, error, headers)
        if code == 200 then
          is_connected = true
          UpdateStatus(0, "Connected")
          Controls.remote_hostname.String = host
          Controls.remote_platform.String = "REST API"
          Controls.remote_version.String = "Connected"
          Controls.remote_uptime.String = "Online"
          
          -- Start keep-alive monitor
          if keepalive_timer then
            keepalive_timer:Stop()
          end
          
          keepalive_timer = Timer.New()
          keepalive_timer.EventHandler = function()
            if is_connected then
              HttpClient.Download {
                Url = url,
                Timeout = 3,
                EventHandler = function(tbl, code, data, error, headers)
                  if code == 200 then
                    Controls.remote_uptime.String = "Online"
                    if Controls.connection_status.Value ~= 0 then
                      UpdateStatus(0, "Connected")
                    end
                  else
                    UpdateStatus(2, "Keep-alive failed")
                    is_connected = false
                    Controls.connect.Boolean = false
                    if auto_reconnect then
                      ScheduleReconnect()
                    end
                  end
                end
              }
            end
          end
          keepalive_timer:Start(10)
          
        else
          UpdateStatus(2, "Connection failed: " .. (error or "Unknown error"))
          Controls.connect.Boolean = false
          if auto_reconnect then
            ScheduleReconnect()
          end
        end
      end
    }
  end
  
  function ScheduleReconnect()
    if reconnect_timer then
      reconnect_timer:Stop()
    end
    
    reconnect_timer = Timer.New()
    reconnect_timer.EventHandler = function()
      if Controls.connect.Boolean then
        Debug("Attempting reconnect...")
        Connect()
      end
    end
    reconnect_timer:Start(5)
  end
  
  function Disconnect()
    if keepalive_timer then
      keepalive_timer:Stop()
      keepalive_timer = nil
    end
    
    if reconnect_timer then
      reconnect_timer:Stop()
      reconnect_timer = nil
    end
    
    is_connected = false
    UpdateStatus(5, "Disconnected")
    Controls.remote_hostname.String = ""
    Controls.remote_version.String = ""
    Controls.remote_platform.String = ""
    Controls.remote_uptime.String = ""
    Debug("Disconnected")
  end
  
  local function SendCommand(command_data)
    if not is_connected then
      UpdateStatus(2, "Not connected")
      return
    end
    
    local host = GetHost()
    local port = GetPort()
    local password = GetPassword()
    
    -- Add password to command
    command_data.password = password
    
    local json_data = BuildJsonString(command_data)
    Debug("Sending: " .. json_data)
    
    local url = HttpClient.CreateUrl({
      Host = host,
      Port = port,
      Path = "command"
    })
    
    HttpClient.Upload {
      Url = url,
      Headers = {
        ["Content-Type"] = "application/json"
      },
      Method = "POST",
      Data = json_data,
      Timeout = 10,
      EventHandler = function(tbl, code, data, error, headers)
        if code == 200 then
          Debug("Command successful: " .. data)
          
          -- Parse and format the response for better readability
          local formatted_response = ParseResponse(data)
          Controls.last_response.String = formatted_response
        else
          local err_msg = error or "Unknown error"
          Debug("Command failed: " .. err_msg)
          
          -- Format error response
          local formatted_error = "ERROR: " .. err_msg
          Controls.last_response.String = formatted_error
          
          if code == 0 or code == nil then
            is_connected = false
            UpdateStatus(2, "Connection lost")
            Controls.connect.Boolean = false
            if auto_reconnect then
              ScheduleReconnect()
            end
          end
        end
      end
    }
  end
  
  -- Connection Control
  Controls.connect.EventHandler = function()
    if Controls.connect.Boolean then
      Connect()
    else
      Disconnect()
    end
  end
  
  -- System Commands
  Controls.shutdown.EventHandler = function()
    local time = tonumber(Controls.shutdown_time.String) or 1
    SendCommand({ command = "shutdown", time = time })
  end
  
  Controls.shutdown_cancel.EventHandler = function()
    SendCommand({ command = "shutdown_cancel" })
  end
  
  Controls.reboot.EventHandler = function()
    SendCommand({ command = "reboot" })
  end
  
  Controls.lock.EventHandler = function()
    SendCommand({ command = "lock" })
  end
  
  -- Script Execution
  Controls.run_script.EventHandler = function()
    local script = Controls.script_path.String
    local args = Controls.script_args.String
    local stdin = Controls.script_stdin.String
    
    if script == "" then
      UpdateStatus(2, "Script path cannot be empty")
      return
    end
    
    local cmd_data = { command = "runScript", scriptPath = script }
    if args ~= "" then
      cmd_data.args = args
    end
    if stdin ~= "" then
      cmd_data.stdin = stdin
    end
    
    SendCommand(cmd_data)
  end
  
  -- Alert System
  Controls.send_alert.EventHandler = function()
    local message = Controls.alert_message.String
    
    if message == "" then
      UpdateStatus(2, "Alert message cannot be empty")
      return
    end
    
    SendCommand({ command = "sendAlert", message = message })
  end
  
  -- System Info
  Controls.get_system_info.EventHandler = function()
    SendCommand({ command = "getSystemInfo" })
  end
  
  Controls.get_fonts.EventHandler = function()
    SendCommand({ command = "getFonts" })
  end
  
  -- App Control
  Controls.focus_app.EventHandler = function()
    local app = Controls.app_name.String
    
    if app == "" then
      UpdateStatus(2, "App name cannot be empty")
      return
    end
    
    SendCommand({ command = "focusApp", appName = app })
  end
  
  Controls.quit_app.EventHandler = function()
    local app = Controls.app_name.String
    
    if app == "" then
      UpdateStatus(2, "App name cannot be empty")
      return
    end
    
    SendCommand({ command = "quitApp", appName = app })
  end
  
  -- Input Commands
  Controls.send_input.EventHandler = function()
    local input_type = Controls.input_type.String
    local input_key = Controls.input_key.String
    
    if input_type == "" or input_key == "" then
      UpdateStatus(2, "Input type and key cannot be empty")
      return
    end
    
    SendCommand({ command = "sendInput", type = input_type, key = input_key })
  end
  
  -- File Commands
  Controls.move_file.EventHandler = function()
    local source = Controls.file_source.String
    local dest = Controls.file_dest.String
    local copy_only = Controls.file_copy_only.Boolean
    
    if source == "" or dest == "" then
      UpdateStatus(2, "Source and destination paths required")
      return
    end
    
    SendCommand({ command = "moveFile", sourcePath = source, destPath = dest, copyOnly = copy_only })
  end
  
  -- Custom Command
  Controls.send_custom.EventHandler = function()
    local command = Controls.custom_command.String
    local json_str = Controls.custom_json.String
    
    if command == "" then
      UpdateStatus(2, "Command cannot be empty")
      return
    end
    
    local host = GetHost()
    local port = GetPort()
    local password = GetPassword()
    
    -- If JSON provided, use it directly with password appended
    if json_str ~= "" and json_str:sub(1,1) == "{" then
      -- Trim whitespace and ensure it ends with }
      json_str = json_str:match("^%s*(.-)%s*$")
      if json_str:sub(-1) ~= "}" then
        UpdateStatus(2, "Invalid JSON format - must end with }")
        return
      end
      local json_with_password = json_str:sub(1, -2) .. ',"password":"' .. password .. '"}'
      
      local url = HttpClient.CreateUrl({
        Host = host,
        Port = port,
        Path = "command"
      })
      
      HttpClient.Upload {
        Url = url,
        Headers = { ["Content-Type"] = "application/json" },
        Method = "POST",
        Data = json_with_password,
        Timeout = 10,
        EventHandler = function(tbl, code, data, error, headers)
          if code == 200 then
            Controls.last_response.String = data
          else
            Controls.last_response.String = "Error: " .. (error or "Unknown")
          end
        end
      }
    else
      SendCommand({ command = command })
    end
  end
  
  -- Preset Command Buttons
  for i = 1, Properties["Command Buttons"].Value do
    Controls["cmd_" .. i .. "_trigger"].EventHandler = function()
      local json_str = Controls["cmd_" .. i .. "_json"].String
      
      if json_str == "" then
        UpdateStatus(2, "Command " .. i .. " JSON cannot be empty")
        return
      end
      
      local host = GetHost()
      local port = GetPort()
      local password = GetPassword()
      
      if json_str:sub(1,1) == "{" then
        -- Trim whitespace and ensure it ends with }
        json_str = json_str:match("^%s*(.-)%s*$")
        if json_str:sub(-1) ~= "}" then
          UpdateStatus(2, "Invalid JSON for command " .. i .. " - must end with }")
          return
        end
        local json_with_password = json_str:sub(1, -2) .. ',"password":"' .. password .. '"}'
        
        local url = HttpClient.CreateUrl({
          Host = host,
          Port = port,
          Path = "command"
        })
        
        HttpClient.Upload {
          Url = url,
          Headers = { ["Content-Type"] = "application/json" },
          Method = "POST",
          Data = json_with_password,
          Timeout = 10,
          EventHandler = function(tbl, code, data, error, headers)
            if code == 200 then
              Controls.last_response.String = data
            else
              Controls.last_response.String = "Error: " .. (error or "Unknown")
            end
          end
        }
      else
        UpdateStatus(2, "Invalid JSON for command " .. i)
      end
    end
  end
  
  -- Initialize
  UpdateStatus(5, "Initialized - Ready to connect")
  
  -- Initialize connection fields with defaults
  Controls.host.String = Properties["IP Address"].Value
  Controls.port.String = tostring(Properties["Port"].Value)
  Controls.password.String = Properties["Password"].Value
  
  -- Initialize other controls
  Controls.shutdown_time.String = "1"
  
  Debug("ScriptLauncher Control Plugin Initialized")
  Debug("Host: " .. GetHost() .. ":" .. tostring(GetPort()))
end
